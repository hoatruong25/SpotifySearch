GET /normal-index-for-test/_search
{
  "size": 0,
  "aggs": {
    "Terms_Aggregation": {
      "terms": {
        "field": "album_name.keyword"
      }
    }
  }
}

GET /normal-index-for-test/_search
{
  "query": {
    "term": {
      "artist_name.keyword": {
        "value": "John Mayer"
      }
    }
  }
}

GET /normal-index-for-test/_search
{
  "query": {
    "bool": {
      "must": [
        {
          "match": {
            "artist_name.keyword": "John Mayer"
          }
        },
        {
          "match": {
            "track_name.keyword": "Daughters"
          }
        }
      ],
      "filter": [
        {
          "range": {
            "ts": {
              "gte": "2017-04-01",
              "lte": "2018-04-01"
            }
          }
        }
      ]
    }
  }
}
GET /normal-index-for-test/_search
{
  "query": {
    "dis_max": {
      "queries": [
        { "match": { "track_name": "Impossible" }},
        { "match": { "album_name": "Impossible" }}
      ],
      "tie_breaker": 0.3
    }
  }
}

GET /normal-index-for-test/_search
{
  "query": {
    "constant_score": {
      "filter": {
        "term": { "platform": "web player" }
      },
      "boost": 1.0
    }
  }
}

GET /normal-index-for-test/_search
{
  "query": {
    "fuzzy": {
      "artist_name.keyword": {
        "value": "Ln Del Rey",
        "fuzziness": "AUTO"
      }
    }
  }
}

